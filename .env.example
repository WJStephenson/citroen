# Copy to .env.local (git-ignored) and adjust.
# Everything here is optional — the VIN can also be set at runtime in Settings.

# Path the PWA prefixes onto bridge calls. nginx strips it before proxying.
VITE_API_BASE=/api

# Default VIN. A value entered in the app's Settings sheet overrides this.
VITE_VIN=

# Background poll interval in minutes. Floored at 5 in config.ts — a lower
# value here is ignored. The floor is about not leaning on Stellantis's API:
# a read never reaches the car, so it costs the 12V battery nothing.
VITE_POLL_MINUTES=5

# Dev server only: where `npm run dev` proxies /api/*.
#   local mock ......... http://127.0.0.1:5001
#   real bridge on LAN . http://192.168.1.x:5000
VITE_API_PROXY_TARGET=http://127.0.0.1:5001

# Path the PWA prefixes onto shared-settings calls (VIN, poll interval,
# tariff, dashboard layout, charge hints). nginx strips it before proxying to
# the settings_store sidecar — see deploy/docker-compose.settings.yml.
VITE_SETTINGS_BASE=/settings

# Dev server only: where `npm run dev` proxies /settings/. Run alongside the
# mock with `npm run settings-store` (defaults to this same port).
VITE_SETTINGS_PROXY_TARGET=http://127.0.0.1:5002

# Public half of the VAPID keypair "notify when charging finishes" signs
# pushes with — see deploy/charge-notify/. Safe to commit/expose (it's the
# public key); the private half lives only in that service's .env on the
# server, never here. Notifications are silently unavailable without this
# set — see push.ts::isPushSupported.
VITE_VAPID_PUBLIC_KEY=
