# ---- Android wrapper ----

android/.gradle/
android/build/
android/app/build/
android/local.properties

# The widget's Cloudflare Access service token and the car's VIN. Copy
# android/secrets.properties.example to make one.
android/secrets.properties

# The app signing key and its password. This is the app's identity — Android
# only installs updates signed with the same key, and assetlinks.json on the
# host names its fingerprint. It never belongs in the repo; CI gets a base64
# copy from a GitHub secret. See deploy/make-signing-key.sh.
*.jks
*.keystore
android/keystore.properties
