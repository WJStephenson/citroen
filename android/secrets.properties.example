# Copy to android/secrets.properties (git-ignored) for a local build.
#
# CI reads these same three keys from the environment instead, populated from
# GitHub secrets — see .github/workflows/android.yml. A build with none of them
# set still compiles and installs; the widget just says "Not set up", which is
# a better failure than an unexplained 403.
#
# The hostname is NOT here. It is a resource, in
# android/app/src/main/res/values/config.xml, because the TWA's intent filter
# and its asset statement need it too.

# The car. Same VIN the app's Settings sheet holds.
CITROEN_VIN=

# A Cloudflare Access **service token**, created under
# Zero Trust > Access > Service Auth. Scope it to the read path only —
# /api/get_vehicleinfo/* — and leave the rest of the hostname on your normal
# email/IdP policy. This token lives in an APK on a phone, and the bridge
# behind it has no authentication of its own: one that can also reach
# /preconditioning or /lock_door is a car key on the lock screen.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
