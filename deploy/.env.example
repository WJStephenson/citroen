# Copy to .env in this same directory (git-ignored) — docker-compose.notify.yml
# loads it via env_file. Generate a keypair with generate_vapid_keys.py; the
# public half goes in the PWA's own .env as VITE_VAPID_PUBLIC_KEY, not here.

# The raw base64url private key generate_vapid_keys.py printed.
VAPID_PRIVATE_KEY=

# A mailto: or https: URL identifying the server operator, required by the
# push protocol so a provider can reach you about a misbehaving sender.
VAPID_SUBJECT=mailto:you@example.com
