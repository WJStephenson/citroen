{
  "name": "citroen-ec4-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Custom Citroen e-C4 control PWA, fronting a self-hosted psa_car_controller bridge.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "mock": "python mock/mock_psacc.py",
    "settings-store": "python deploy/settings_store.py --port 5002 --path settings-data/settings.json"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
